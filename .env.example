# Backend API Base URL
# Point this to your backend server (local or production)
# In Vite, all client-exposed variables must be prefixed with VITE_
VITE_API_BASE_URL=http://localhost:3000

# Alias for API URL (used for media / uploads resolution)
VITE_API_URL=http://localhost:3000
